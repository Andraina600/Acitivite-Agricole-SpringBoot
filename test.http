### Base URL
@baseUrl = http://localhost:8080

### Remplace cet UUID par celui retourné après POST /collectivities
@collectivityId = 0e49ff72-5efd-45d9-b5b8-2dd6978e7254

### ================================================================
### POST /collectivities — TEST 1 : Création réussie (201)
###   ✅ federationApproval = true
###   ✅ 10 membres dont 5 avec > 6 mois d'ancienneté
###   ✅ structure complète
### ================================================================
POST {{baseUrl}}/collectivities
Content-Type: application/json

[
  {
    "location": "Antananarivo",
    "federationApproval": true,
    "members": [
      "11111111-1111-1111-1111-111111111111",
      "22222222-2222-2222-2222-222222222222",
      "33333333-3333-3333-3333-333333333333",
      "44444444-4444-4444-4444-444444444444",
      "55555555-5555-5555-5555-555555555555",
      "66666666-6666-6666-6666-666666666666",
      "77777777-7777-7777-7777-777777777777",
      "88888888-8888-8888-8888-888888888888",
      "99999999-9999-9999-9999-999999999999",
      "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
    ],
    "structure": {
      "president":     "11111111-1111-1111-1111-111111111111",
      "vicePresident": "22222222-2222-2222-2222-222222222222",
      "treasurer":     "33333333-3333-3333-3333-333333333333",
      "secretary":     "44444444-4444-4444-4444-444444444444"
    }
  }
]

